{
  "version": 1,
  "root": "/absolute/canonical/path/to/synthetic-memory",
  "allow": [
    "projects/**",
    "decisions/**",
    "workflows/**"
  ],
  "deny": [
    "**/private/**",
    "**/drafts/**"
  ],
  "allow_cron": false,
  "allow_subagents": false,
  "limits": {
    "max_results": 10,
    "default_results": 5,
    "snippet_chars": 300,
    "total_chars": 4000
  }
}
